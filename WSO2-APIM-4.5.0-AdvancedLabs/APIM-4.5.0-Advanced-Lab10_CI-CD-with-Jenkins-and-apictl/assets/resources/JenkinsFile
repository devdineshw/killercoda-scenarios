

pipeline {

    agent any

    options {
        buildDiscarder logRotator( 
                    daysToKeepStr: '5', 
                    numToKeepStr: '5'
            )
    }

    stages {
        
        stage('Preparation') {
            steps{
                dir('api-source-repository') {
                    git branch: "main",
                    url: 'https://github.com/<GIT_ACCOUNT>/api-source-repository.git'
                }
                dir('api-deploy-state-repository') {
                    git branch: "dev",
                    url: 'https://github.com/<GIT_ACCOUNT>/api-deploy-state-repository.git'
                }
            }
        }

        stage('Setup Environment for APICTL') {
            steps {
                sh '''#!/bin/bash
                #rm /var/lib/jenkins/workspace/gitconfig
                #touch /var/lib/jenkins/workspace/gitconfig
                apictl set --vcs-config-path /var/lib/jenkins/workspace/gitconfig

                envs=$(apictl get envs --format "{{.Name}}")
                if [ -z "$envs" ]; 
                then 
                    echo "No environment configured. Setting dev environment.."
                    apictl add env dev --apim ${APIM_DEV_HOST} 
                else
                    echo "Environments :"$envs
                    if [[ $envs != *"dev"* ]]; then
                    echo "Dev environment is not configured. Setting dev environment.."
                    apictl add env dev --apim {APIM_DEV_HOST}
                    fi
                fi
                '''
            }
        }

        stage('Build api bundles and upload') {
            steps {
                dir('api-source-repository') {
                    sh '''#!/bin/bash

                    apictl login dev -u admin -p admin -k

                    apis=$(apictl vcs status -e dev --format="{{ jsonPretty . }}" | jq -r '.API | .[] | .NickName')
                    mkdir -p upload
                    if [ -z "$apis" ]; 
                    then 
                        echo "======== No API Changes detected =========="; 
                    else 
                        echo "Updated APIs :"$apis
                        apiArray=($apis)
                        for i in "${apiArray[@]}"
                        do
                            echo "$i"
                            apictl bundle -s $i -d upload

                            # get the artifact deploy version from the meta.yaml
                            #versionFull=$(cat $i/meta.yaml)
                            #versionId=(${versionFull//: / })
                            #version=${versionId[1]}

                            for file in upload/*; do
                                echo "Uploading "$file
                                #curl -u ${ARTIFACTORY_USER}:${ARTIFACTORY_PWD} -X PUT https://${ARTIFACTORY_HOST}/artifactory/${ARTIFACTORY_REPO}/$i/$version/ -T $file
                                
                                # import the artifact
                                fileName=$(echo $file | sed -r "s/.+\\/(.+)\\..+/\\1/")       # Get the zip file name without the extention
                                deploymentName=$(echo $fileName | sed "s/\\(.*\\)_/\\1-/")    # replace _ with -
                                paramPath="../api-deploy-state-repository/DeploymentArtifacts_"$deploymentName
                                echo "Param path :"$paramPath

                                message=$(apictl import api -f $file --params $paramPath -e dev --update -k)
                                if [ "$message" = "Successfully imported API." ]; then
                                    echo "Successfully imported API."
                                else
                                    echo $message
                                fi

                            done
                            rm -rf upload
                        done
                    fi

                    '''
                }
            }
        }

        stage('Update local repo') {
            steps {
                dir('api-source-repository') {
                    sh '''#!/bin/bash
                    idFull=$(cat vcs.yaml)
                    arrId=(${idFull//: / })
                    repoId=${arrId[1]}
                    head=$(git rev-parse HEAD)

                    rm /var/lib/jenkins/workspace/gitconfig
                    echo "
    repos:
    $repoId:
        environments:
        dev:
            lastAttemptedRev: $head" >> /var/lib/jenkins/workspace/gitconfig
                    '''
                }
            }
        }
    }   
}

